# ── CHISEL Environment Variables (Template) ──
# Copy to .env and fill in real values.

# Pollinations.ai API key for cover image generation
POLLINATIONS_API_KEY=sk_your_key_here

# Database
# Local dev  : sqlite+aiosqlite:///./chisel.db
# Neon       : paste the connection string as-is (sslmode=require is converted for asyncpg)
DATABASE_URL=sqlite+aiosqlite:///./chisel.db

# JWT signing secret — MUST be a strong random string in production
SECRET_KEY=chisel-dev-secret-change-in-production

# ── Security settings (added in v1.1) ──
# "production" refuses to boot with the default SECRET_KEY, DEMO_RETURN_OTP=true or CORS_ORIGINS=*
ENVIRONMENT=development
# Return the OTP in /api/register responses (viva demo only — set false when emailing OTPs)
DEMO_RETURN_OTP=true
# Comma-separated emails allowed to call /api/admin/*
ADMIN_EMAILS=admin@example.com
# Comma-separated allowed browser origins. Leave empty for a mobile-only app;
# "*" only for local dev with a browser frontend.
CORS_ORIGINS=

# Brevo (free: 300 emails/day). Leave BREVO_API_KEY empty locally to print OTPs to the log.
BREVO_API_KEY=
EMAIL_SENDER_ADDRESS=
EMAIL_SENDER_NAME=CHISEL
# Auth requests (register + verify) allowed per IP per minute
AUTH_RATE_LIMIT_PER_MINUTE=20
